# ------------------------------------------------------------------------------
# This is an example .env file.
#
# All of these environment vars must be defined either in your environment or in
# a local .env file in order to run this app.
#
# @see https://github.com/rolodato/dotenv-safe for more details.
# ------------------------------------------------------------------------------

# Optional (shared search/site metadata caches, webhook coordination, and previews)
# Enable only in Vercel Production/Preview to avoid consuming commands in dev.
# Use REDIS_URL (Upstash uses rediss://), or REDIS_HOST and REDIS_PASSWORD.
#REDIS_ENABLED=true
#REDIS_URL=
#REDIS_HOST=
#REDIS_PASSWORD=
#REDIS_USER='default'
#REDIS_NAMESPACE='preview-images'

# Optional (refresh existing pages on content edits; rebuild for other changes)
# NOTE: /api/notion-webhook logs NOTION_VERIFICATION_TOKEN when the Notion webhook
# subscription is created; VERCEL_DEPLOY_HOOK_URL comes from Project Settings > Git
#NOTION_VERIFICATION_TOKEN=
#VERCEL_DEPLOY_HOOK_URL=
