{
  "name": "portfolio-v3",
  "version": "2.0.1",
  "private": true,
  "description": "Showcasing skills through work, projects, and blog posts.",
  "license": "MIT",
  "author": "Kalen Wallin <kalenwallin1@gmail.com>",
  "repository": "kalenwallin/portfolio.v3",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3005 --experimental-https --experimental-https-key certificates/dev-key.pem --experimental-https-cert certificates/dev.pem",
    "build": "next build",
    "start": "next start --port 3005",
    "deploy": "vercel deploy",
    "deps:upgrade": "[ -z $GITHUB_ACTIONS ] && bun update --latest notion-client notion-types notion-utils react-notion-x || echo 'Skipping deps:update on CI'",
    "deps:link": "[ -z $GITHUB_ACTIONS ] && run-s deps:link:* || echo 'Skipping deps:update on CI'",
    "deps:unlink": "[ -z $GITHUB_ACTIONS ] && bun add notion-client notion-types notion-utils react-notion-x || echo 'Skipping deps:update on CI'",
    "deps:link:notion-types": "bun link --cwd ../react-notion-x/packages/notion-types && bun link notion-types",
    "deps:link:notion-utils": "bun link --cwd ../react-notion-x/packages/notion-utils && bun link notion-utils",
    "deps:link:notion-client": "bun link --cwd ../react-notion-x/packages/notion-client && bun link notion-client",
    "deps:link:react-notion-x": "bun link --cwd ../react-notion-x/packages/react-notion-x && bun link react-notion-x",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "test": "run-p test:*",
    "test:lint": "oxlint",
    "test:format": "oxfmt --check"
  },
  "dependencies": {
    "@fisch0920/use-dark-mode": "^2.4.0",
    "@keyvhq/core": "^1.6.26",
    "@keyvhq/redis": "^1.6.28",
    "@vercel/analytics": "^1.6.1",
    "classnames": "^2.5.1",
    "expiry-map": "^2.0.0",
    "fathom-client": "^3.7.2",
    "katex": "^0.16.47",
    "ky": "^1.14.3",
    "lqip-modern": "^2.2.1",
    "next": "^16.3.6",
    "notion-client": "^7.12.1",
    "notion-types": "^7.12.1",
    "notion-utils": "^7.12.1",
    "p-map": "^7.0.8",
    "p-memoize": "^8.0.0",
    "posthog-js": "^1.434.2",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-body-classname": "^1.3.1",
    "react-dom": "^19.3.0",
    "react-notion-x": "^7.12.1",
    "react-tweet": "^3.3.1",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-body-classname": "^1.1.10",
    "@types/react-dom": "^19.3.0",
    "@types/rss": "^0.0.32",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,css,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.8",
  "trustedDependencies": [
    "canvas",
    "core-js",
    "protobufjs",
    "sharp",
    "simple-git-hooks"
  ]
}
