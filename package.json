{
  "name": "portfolio-v3",
  "version": "2.0.1",
  "private": true,
  "description": "Showcasing skills through work, projects, and blog posts.",
  "author": "Kalen Wallin <kalenwallin1@gmail.com>",
  "repository": "kalenwallin/portfolio.v3",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "deploy": "vercel deploy",
    "deps:upgrade": "[ -z $GITHUB_ACTIONS ] && pnpm up -L notion-client notion-types notion-utils react-notion-x || echo 'Skipping deps:update on CI'",
    "deps:link": "[ -z $GITHUB_ACTIONS ] && run-s deps:link:* || echo 'Skipping deps:update on CI'",
    "deps:unlink": "[ -z $GITHUB_ACTIONS ] && pnpm add notion-client notion-types notion-utils react-notion-x || echo 'Skipping deps:update on CI'",
    "deps:link:notion-types": "pnpm link ../react-notion-x/packages/notion-types",
    "deps:link:notion-utils": "pnpm link ../react-notion-x/packages/notion-utils",
    "deps:link:notion-client": "pnpm link ../react-notion-x/packages/notion-client",
    "deps:link:react-notion-x": "pnpm link ../react-notion-x/packages/react-notion-x",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "run-p test:*",
    "test:lint": "biome check ."
  },
  "dependencies": {
    "@fisch0920/use-dark-mode": "^2.4.0",
    "@keyvhq/core": "^1.6.9",
    "@keyvhq/redis": "^1.6.10",
    "@vercel/analytics": "^1.5.0",
    "classnames": "^2.5.1",
    "expiry-map": "^2.0.0",
    "fathom-client": "^3.4.1",
    "katex": "^0.16.28",
    "ky": "^1.14.3",
    "lqip-modern": "^2.2.1",
    "next": "^16.2.0",
    "notion-client": "^7.10.0",
    "notion-types": "^7.10.0",
    "notion-utils": "^7.10.0",
    "p-map": "^7.0.4",
    "p-memoize": "^8.0.0",
    "posthog-js": "^1.362.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-body-classname": "^1.3.1",
    "react-dom": "^19.2.4",
    "react-notion-x": "^7.10.0",
    "react-tweet": "^3.3.0",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/node": "^25.5.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.14",
    "@types/react-body-classname": "^1.1.10",
    "@types/rss": "^0.0.32",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "cacheable-request": {
      "keyv": "npm:@keyvhq/core@~1.6.6"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write"
    ]
  }
}
